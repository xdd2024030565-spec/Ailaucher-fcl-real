<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_container_white"
        android:orientation="vertical"
        android:padding="16dp">

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI 控制器"
            android:textSize="20sp"
            android:textStyle="bold"
            app:auto_text_tint="true" />

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:text="让 AI 操控 Minecraft：自控 / 本地假人 / 远程假人，支持聊天对话。"
            android:textSize="12sp"
            app:auto_text_tint="true" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray" />

        <!-- 模式 -->
        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="AI 模式"
            android:textSize="14sp"
            app:auto_text_tint="true" />

        <Spinner
            android:id="@+id/sp_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="自控=AI 驾驶你的角色（通用）；本地假人=生成真假人（仅本地存档）；远程假人=第二实例小号（支持服务器）"
            android:textSize="11sp"
            app:auto_text_tint="true" />

        <!-- LLM 配置 -->
        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="API Key"
            android:textSize="14sp"
            app:auto_text_tint="true" />

        <EditText
            android:id="@+id/et_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sk-..."
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true" />

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Base URL"
            android:textSize="14sp"
            app:auto_text_tint="true" />

        <EditText
            android:id="@+id/et_base_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://api.openai.com/v1"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:singleLine="true" />

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="模型"
            android:textSize="14sp"
            app:auto_text_tint="true" />

        <EditText
            android:id="@+id/et_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="gpt-4o-mini / deepseek-chat"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true" />

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="任务描述"
            android:textSize="14sp"
            app:auto_text_tint="true" />

        <EditText
            android:id="@+id/et_task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="探索世界并生存下去"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <!-- 桥接参数 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.tungsten.fcllibrary.component.view.FCLTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="主实例端口"
                    android:textSize="14sp"
                    app:auto_text_tint="true" />

                <EditText
                    android:id="@+id/et_port"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="25580"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:singleLine="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.tungsten.fcllibrary.component.view.FCLTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="决策间隔 (ms)"
                    android:textSize="14sp"
                    app:auto_text_tint="true" />

                <EditText
                    android:id="@+id/et_cycle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="3000"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- 假人设置 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@android:color/darker_gray" />

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="假人设置"
            android:textSize="16sp"
            android:textStyle="bold"
            app:auto_text_tint="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.tungsten.fcllibrary.component.view.FCLTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="假人名称"
                    android:textSize="14sp"
                    app:auto_text_tint="true" />

                <EditText
                    android:id="@+id/et_fake_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="AI-Bot"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:singleLine="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.tungsten.fcllibrary.component.view.FCLTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="第二实例端口"
                    android:textSize="14sp"
                    app:auto_text_tint="true" />

                <EditText
                    android:id="@+id/et_alt_port"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="25581"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- 对话 -->
        <Switch
            android:id="@+id/sw_dialogue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="启用聊天对话 (提及 AI 名字或触发词时回复)"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_dialogue_trigger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="对话触发词 (@ai)"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true" />

        <!-- 选项 -->
        <Switch
            android:id="@+id/sw_auto_bridge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="启动游戏时自动注入 AI Bridge Mod"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/sw_visual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="视觉模式 (截图 + 多模态 LLM)"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/sw_memory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="启用记忆系统"
            android:textSize="14sp" />

        <!-- 操作按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.tungsten.fcllibrary.component.view.FCLButton
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="保存"
                app:ripple="true" />

            <com.tungsten.fcllibrary.component.view.FCLButton
                android:id="@+id/btn_install_bridge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="安装 Bridge Mod"
                app:ripple="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.tungsten.fcllibrary.component.view.FCLButton
                android:id="@+id/btn_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="启动 AI 控制器"
                app:ripple="true" />

            <com.tungsten.fcllibrary.component.view.FCLButton
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="停止 AI 控制器"
                app:ripple="true" />
        </LinearLayout>

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:id="@+id/tv_ai_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="AI 控制器：已停止"
            android:textSize="14sp"
            app:auto_text_tint="true" />

    </LinearLayout>
</ScrollView>
